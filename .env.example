# ============================================================
# BuildingOS - Local environment configuration
# ============================================================

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------

BACKEND_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=buildingos
POSTGRES_USER=buildingos
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+psycopg://buildingos:change-me-in-local-env@localhost:5432/buildingos

# ------------------------------------------------------------
# MQTT / Mosquitto
# ------------------------------------------------------------

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=buildingos
MQTT_PASSWORD=change-me-in-local-env

# ------------------------------------------------------------
# Reverse proxy
# ------------------------------------------------------------

PUBLIC_HOSTNAME=localhost